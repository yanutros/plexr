{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "node scripts/fetch-mpv.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/fetch-mpv.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Plexr",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": {
      "mpv-win/mpv.exe": "mpv/mpv.exe",
      "mpv-win/d3dcompiler_43.dll": "mpv/d3dcompiler_43.dll",
      "mpv-win/mpv/fonts.conf": "mpv/mpv/fonts.conf"
    }
  }
}
